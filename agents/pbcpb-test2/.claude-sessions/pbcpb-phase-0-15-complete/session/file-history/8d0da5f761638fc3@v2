{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VST Plugin Knowledge Base Entry Schema",
  "description": "Schema for all knowledge base entries across all layers",
  "type": "object",
  "required": [
    "id",
    "kb",
    "topic",
    "status",
    "version",
    "title",
    "summary",
    "description",
    "source",
    "concepts",
    "tags",
    "related_topics",
    "difficulty",
    "domain_relevance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+_[a-z0-9-]+_[a-z0-9-]+$",
      "description": "Unique identifier: {kb-name}_{topic}_{entry-name}",
      "examples": ["technical_realtime-safety_atomic-audio", "sound-design_synthesis-types_subtractive-basics"]
    },
    "kb": {
      "type": "string",
      "enum": ["technical", "sound-design", "ui-ux", "commercial", "reference"],
      "description": "Which knowledge base layer this entry belongs to"
    },
    "topic": {
      "type": "string",
      "description": "Topic within the KB layer",
      "examples": ["realtime-safety", "synthesis-types", "control-types", "marketplaces"]
    },
    "status": {
      "type": "string",
      "enum": ["placeholder", "harvested", "curated", "synced"],
      "default": "placeholder",
      "description": "Content status: placeholder (needs content), harvested (auto-populated), curated (reviewed), synced (from external source)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver version of this entry",
      "examples": ["1.0.0", "2.1.0"]
    },
    "title": {
      "type": "string",
      "maxLength": 100,
      "description": "Human-readable title"
    },
    "summary": {
      "type": "string",
      "maxLength": 200,
      "description": "One-sentence summary"
    },
    "description": {
      "type": "string",
      "description": "Full explanation with examples, usage, context"
    },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["official-docs", "textbook", "paper", "tutorial", "community-forum", "expert-opinion", "harvested", "original"],
          "description": "Source type"
        },
        "reference": {
          "type": "string",
          "description": "Citation or URL"
        },
        "author": {
          "type": "string",
          "description": "Author or organization"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Publication or last-updated date"
        },
        "authority_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Override authority score for this specific entry"
        }
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Concept name"
          },
          "description": {
            "type": "string",
            "description": "Brief explanation"
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Related concept IDs"
          }
        }
      },
      "description": "Key concepts covered by this entry"
    },
    "code_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["language", "code"],
        "properties": {
          "language": {
            "type": "string",
            "enum": ["cpp", "cmake", "bash", "json", "markdown"],
            "description": "Programming language"
          },
          "code": {
            "type": "string",
            "description": "Code content"
          },
          "preserved": {
            "type": "boolean",
            "default": false,
            "description": "If true, code is preserved exactly during updates"
          },
          "description": {
            "type": "string",
            "description": "What this code demonstrates"
          }
        }
      },
      "description": "Code examples (required for technical KB)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags",
      "examples": [["juce", "audio-thread", "atomic", "realtime"]]
    },
    "related_topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other topics within same KB layer"
    },
    "related_kb_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kb", "entry_id"],
        "properties": {
          "kb": {
            "type": "string",
            "enum": ["technical", "sound-design", "ui-ux", "commercial", "reference"]
          },
          "entry_id": {
            "type": "string"
          },
          "relationship": {
            "type": "string",
            "description": "How the entries are related"
          }
        }
      },
      "description": "Cross-references to entries in other KB layers"
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"],
      "description": "Learning difficulty level"
    },
    "domain_relevance": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Relevance to VST plugin development (1=peripheral, 10=core)"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "supersedes": {
      "type": "string",
      "description": "ID of entry this one replaces (for versioning)"
    },
    "superseded_by": {
      "type": "string",
      "description": "ID of entry that replaces this one (for versioning)"
    }
  },
  "examples": [
    {
      "id": "technical_realtime-safety_atomic-audio",
      "kb": "technical",
      "topic": "realtime-safety",
      "status": "curated",
      "version": "1.0.0",
      "title": "Atomic Operations for Audio Thread Communication",
      "summary": "Using std::atomic for lock-free parameter communication between GUI and audio threads.",
      "description": "The audio thread must never block. std::atomic provides lock-free communication for simple values like parameter changes. Use memory_order_acquire/release for efficiency.",
      "source": {
        "type": "expert-opinion",
        "reference": "timur.audio/using-locks-in-real-time-audio-processing-safely",
        "authority_score": 0.95
      },
      "concepts": [
        {
          "name": "std::atomic",
          "description": "Lock-free atomic operations",
          "related": ["memory_order_acquire", "memory_order_release"]
        },
        {
          "name": "memory_order",
          "description": "Specifies ordering guarantees for atomic operations"
        }
      ],
      "code_blocks": [
        {
          "language": "cpp",
          "code": "std::atomic<float> gainParam{0.5f};\n\n// GUI thread\nvoid setGain(float g) { gainParam.store(g, std::memory_order_release); }\n\n// Audio thread\nfloat getGain() { return gainParam.load(std::memory_order_acquire); }",
          "preserved": true,
          "description": "Thread-safe parameter communication pattern"
        }
      ],
      "tags": ["juce", "audio-thread", "atomic", "realtime", "thread-safety"],
      "related_topics": ["juce-patterns", "dsp-algorithms"],
      "difficulty": "intermediate",
      "domain_relevance": 10
    }
  ]
}