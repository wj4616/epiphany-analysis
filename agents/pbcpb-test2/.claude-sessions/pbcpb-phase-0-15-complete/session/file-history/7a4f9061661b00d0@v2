        "success_criteria": [
          "Purpose statement is one unambiguous paragraph",
          "Scope has explicit in/out/adjacent lists",
          "Success criteria are measurable",
          "Technical constraints documented",
          "Human approved SPEC.md"
        ],
        "tools_available": ["file_creation", "user_questioning"],
        "behavioral_profile": {
          "risk_tolerance": "minimal",
          "creativity_level": "conservative",
          "verbosity": "concise",
          "stance": "supportive"
        }
      },
      "skill_activation": "brainstorming",
      "tasks": [
        "T0.1 Document commission brief from user",
        "T0.2 Define purpose statement",
        "T0.3 Define scope (in/out/adjacent)",
        "T0.4 Define success criteria",
        "T0.5 Define constraints",
        "T0.6 Determine complexity profile"
