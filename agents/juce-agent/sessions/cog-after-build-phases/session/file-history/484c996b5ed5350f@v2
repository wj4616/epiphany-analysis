cmake_minimum_required(VERSION 3.22)
project(CogVST VERSION 1.0.0)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# Enable testing
enable_testing()

include(FetchContent)
FetchContent_Declare(
    JUCE
    GIT_REPOSITORY https://github.com/juce-framework/JUCE.git
    GIT_TAG        7.0.12
    GIT_SHALLOW    TRUE
)
FetchContent_MakeAvailable(JUCE)

# Catch2 for testing
FetchContent_Declare(
    Catch2
    GIT_REPOSITORY https://github.com/catchorg/Catch2.git
    GIT_TAG        v3.5.2
    GIT_SHALLOW    TRUE
)
FetchContent_MakeAvailable(Catch2)

juce_add_plugin(CogVST
    COMPANY_NAME              "CogAudio"
    PLUGIN_MANUFACTURER_CODE  CgAu
    PLUGIN_CODE               CgVs
    FORMATS                   VST3 AU Standalone
    PRODUCT_NAME              "Cog VST"
    IS_SYNTH                  FALSE
    NEEDS_MIDI_INPUT          FALSE
    NEEDS_MIDI_OUTPUT         FALSE
    IS_MIDI_EFFECT            FALSE
    EDITOR_WANTS_KEYBOARD_FOCUS FALSE
    COPY_PLUGIN_AFTER_BUILD   TRUE
    VST3_COPY_DIR             "$ENV{HOME}/.vst3"
)

juce_generate_juce_header(CogVST)

target_sources(CogVST PRIVATE
    src/PluginProcessor.cpp
    src/PluginEditor.cpp
    src/DSP/TextureBodyDetector.cpp
    src/DSP/Waveshaper.cpp
    src/DSP/SpectralDroneEngine.cpp
    src/DSP/ChorusEnsemble.cpp
    src/DSP/ResonantFilter.cpp
    src/DSP/DriveCircuit.cpp
    src/DSP/StereoWidener.cpp
    src/DSP/ModulationEngine.cpp
    src/Presets/PresetManager.cpp
    src/GUI/CogLookAndFeel.cpp
    src/GUI/PresetBar.cpp
)

target_include_directories(CogVST PRIVATE src)

target_compile_definitions(CogVST
    PUBLIC
        JUCE_WEB_BROWSER=0
        JUCE_USE_CURL=0
        JUCE_VST3_CAN_REPLACE_VST2=0
)

target_link_libraries(CogVST
    PRIVATE
        juce::juce_audio_utils
        juce::juce_dsp
    PUBLIC
        juce::juce_recommended_config_flags
        juce::juce_recommended_lto_flags
        juce::juce_recommended_warning_flags
)

# ==============================================================================
# Tests
# ==============================================================================

# DSP sources needed for tests
set(DSP_SOURCES
    src/DSP/TextureBodyDetector.cpp
    src/DSP/Waveshaper.cpp
    src/DSP/SpectralDroneEngine.cpp
    src/DSP/ChorusEnsemble.cpp
    src/DSP/ResonantFilter.cpp
    src/DSP/DriveCircuit.cpp
    src/DSP/StereoWidener.cpp
    src/DSP/ModulationEngine.cpp
)

add_executable(CogVSTTests
    tests/plugin_tests.cpp
    tests/parameter_tests.cpp
    tests/dsp_tests.cpp
    src/PluginProcessor.cpp
    src/PluginEditor.cpp
    ${DSP_SOURCES}
)

target_link_libraries(CogVSTTests
    PRIVATE
        Catch2::Catch2WithMain
        juce::juce_audio_processors
        juce::juce_audio_basics
        juce::juce_dsp
)

# Don't need GUI for tests
target_compile_definitions(CogVSTTests
    PRIVATE
        JUCE_WEB_BROWSER=0
        JUCE_USE_CURL=0
)

target_include_directories(CogVSTTests
    PRIVATE
        ${CMAKE_SOURCE_DIR}/src
)

# Add tests to CTest
include(Catch)
catch_discover_tests(CogVSTTests)