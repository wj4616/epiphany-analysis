    paramDroneDensity = apvts.getRawParameterValue("droneDensity");
    paramSpectralDrift = apvts.getRawParameterValue("spectralDrift");
    paramThickness = apvts.getRawParameterValue("thickness");
    paramFilterRouting = apvts.getRawParameterValue("filterRouting");
    paramFilterACutoff = apvts.getRawParameterValue("filterACutoff");
    paramFilterAReso = apvts.getRawParameterValue("filterAReso");
    paramFilterAType = apvts.getRawParameterValue("filterAType");
    paramFilterBCutoff = apvts.getRawParameterValue("filterBCutoff");
    paramFilterBReso = apvts.getRawParameterValue("filterBReso");
    paramFilterBType = apvts.getRawParameterValue("filterBType");
    paramDrive = apvts.getRawParameterValue("drive");
    paramTone = apvts.getRawParameterValue("tone");
    paramFeedback = apvts.getRawParameterValue("feedback");
    paramWidth = apvts.getRawParameterValue("width");
    paramEvolutionSpeed = apvts.getRawParameterValue("evolutionSpeed");
    paramComplexity = apvts.getRawParameterValue("complexity");
    paramReactivity = apvts.getRawParameterValue("reactivity");
    paramOutputGain = apvts.getRawParameterValue("outputGain");
    paramMix = apvts.getRawParameterValue("mix");
    paramBypass = apvts.getRawParameterValue("bypass");
    paramFreeze = apvts.getRawParameterValue("freeze");
}

