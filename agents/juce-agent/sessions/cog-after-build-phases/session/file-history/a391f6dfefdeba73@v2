// Fast tanh approximation using Padé approximant
// Error < 0.1% for all inputs
// Formula: x * (27 + x*x) / (27 + 9*x*x)
// Falls back to std::tanh for |x| > 5 to maintain accuracy
inline float fastTanh(float x) noexcept
{
    // Use Padé approximant for normal range
    // For very large inputs, std::tanh approaches 1.0 anyway
    const float absX = std::abs(x);

    if (absX > 5.0f)
    {
        // For |x| > 5, tanh is essentially ±1 with tiny error
        return x > 0.0f ? 1.0f : -1.0f;
    }

    // Padé approximant: x * (27 + x²) / (27 + 9x²)
    const float x2 = x * x;
    return x * (27.0f + x2) / (27.0f + 9.0f * x2);
}

// Fast atan approximation using polynomial fit
// Error < 0.5% for |x| < 5
// Asymptotic behavior for |x| >= 5
inline float fastAtan(float x) noexcept
{
    const float absX = std::abs(x);

    if (absX >= 5.0f)
    {
        // Asymptotic: atan approaches ±π/2
        return x > 0.0f ? 1.57079632679f : -1.57079632679f;
    }

    // Polynomial approximation for |x| < 5
    // atan(x) ≈ x * (π/4 + 0.273*(|x|-1)) for moderate inputs
    // More accurate polynomial: use odd powers
    const float sign = x > 0.0f ? 1.0f : -1.0f;
    const float a = absX;

    // 5th degree polynomial fit
    const float a2 = a * a;
    const float a3 = a2 * a;
    const float a5 = a3 * a2;

    // Coefficients fitted to atan curve
    return sign * (a - 0.333333f * a3 + 0.2f * a5);
}

// Fast exp(-x*x) approximation using rational function
// Useful for Gaussian-style envelope functions
inline float fastExpNegSquare(float x) noexcept
{
    // For |x| > 4, exp(-x²) is essentially 0
    const float absX = std::abs(x);
    if (absX > 4.0f)
        return 0.0f;

    // Rational approximation for exp(-x²)
    // Using Padé-type form for |x| < 4
    const float x2 = x * x;

    // Numerator: 1 / (1 + x²/4 + x⁴/64)
    // This approximates exp(-x²) reasonably well
    return 1.0f / (1.0f + 0.25f * x2 + 0.015625f * x2 * x2);
}

// Fast sqrt approximation - useful for auto-gain calculations
// Uses Newton-Raphson iteration starting from rough estimate
inline float fastSqrt(float x) noexcept
{
    // Handle edge cases
    if (x <= 0.0f) return 0.0f;
    if (x == 1.0f) return 1.0f;

    // Initial estimate using bit manipulation
    union { float f; int32_t i; } u;
    u.f = x;
    u.i = 0x1fbd1df5 + (u.i >> 1);  // Magic number for sqrt estimate

    // One Newton-Raphson iteration for refinement
    float y = u.f;
    y = 0.5f * (y + x / y);

    return y;
}

// Fast inverse sqrt (1/sqrt(x)) - classic Quake algorithm
inline float fastInvSqrt(float x) noexcept
{
    if (x <= 0.0f) return 0.0f;

    float xhalf = 0.5f * x;
    union { float f; int32_t i; } u;
    u.f = x;
    u.i = 0x5f3759df - (u.i >> 1);  // Magic number
    u.f = u.f * (1.5f - xhalf * u.f * u.f);  // Newton-Raphson

    return u.f;
}

// Constrained fast tanh for feedback paths where we know input range
// Assumes |x| < 10, slightly faster than full fastTanh
inline float fastTanhBounded(float x) noexcept
{
    const float x2 = x * x;
    return x * (27.0f + x2) / (27.0f + 9.0f * x2);
}

// Soft clip function: x / (1 + |x|)
// Bounded to (-1, 1), smooth saturation
inline float softClip(float x) noexcept
{
    return x / (1.0f + std::abs(x));
}

// Equal-power cosine crossfade gain
// For mix = 0..1, returns cos(mix * π/2) and sin(mix * π/2)
// Result: dryGain = cos, wetGain = sin
struct CrossfadeGains
{
    float dry;
    float wet;
};

inline CrossfadeGains equalPowerCrossfade(float mix) noexcept
{
    // mix = 0: dry = 1, wet = 0
    // mix = 1: dry = 0, wet = 1
    // mix = 0.5: dry = wet = 0.707 (equal power)
    const float angle = mix * 1.57079632679f;  // mix * π/2
    return { std::cos(angle), std::sin(angle) };
}

// Linear interpolation for delay lines
inline float lerp(float a, float b, float t) noexcept
{
    return a + t * (b - a);
}

