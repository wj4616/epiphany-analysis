void TextureBodyDetector::prepare(double sr, int samplesPerBlock)
{
    sampleRate = sr;
    juce::ignoreUnused(samplesPerBlock);
}

void TextureBodyDetector::process(const float* input, float* textureOut, float* bodyOut, int numSamples)
{
    // TODO: Implement texture/body separation
    for (int i = 0; i < numSamples; ++i)
    {
        textureOut[i] = input[i];
        bodyOut[i] = input[i];
    }
}

void TextureBodyDetector::reset()
{
}

} // namespace CogDSP