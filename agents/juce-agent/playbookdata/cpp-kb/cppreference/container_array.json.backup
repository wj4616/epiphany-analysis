  "html": "<!DOCTYPE html><html lang=\"en\" dir=\"ltr\" class=\"client-nojs\">\n<body class=\"mediawiki ltr sitedir-ltr ns-0 ns-subject page-cpp_container_array skin-cppreference2 action-view cpp-navbar\">\n        <!-- header -->\n        <div id=\"mw-head\" class=\"noprint\">\n            <div id=\"cpp-head-first-base\">\n                <div id=\"cpp-head-first\">\n                    <h5><a href=\"https://en.cppreference.com/index.html\">\n                        cppreference.com                        </a></h5>\n                    <div id=\"cpp-head-search\">\n                        \n<!-- 0 -->\n<div id=\"p-search\">\n<form action=\"https://duckduckgo.com/\" method=\"get\">\n  \n  <input type=\"search\" name=\"q\">\n  <input type=\"submit\" value=\"Search\">\n</form>\n</div>\n\n<!-- /0 -->\n                    </div>\n                    <div id=\"cpp-head-personal\">\n                        \n<!-- 0 -->\n<div id=\"p-personal\" class=\"\">\n<span id=\"pt-createaccount\"><a href=\"https://en.cppreference.com/mwiki/index.php?title=Special:UserLogin&amp;returnto=cpp%2Fcontainer%2Farray&amp;type=signup\">Create account</a></span>\t<div class=\"menu\">\n        <ul>\n<li id=\"pt-login\"><a href=\"https://en.cppreference.com/mwiki/index.php?title=Special:UserLogin&amp;returnto=cpp%2Fcontainer%2Farray\" title=\"You are encouraged to log in; however, it is not mandatory [o]\" accesskey=\"o\">Log in</a></li>        </ul>\n    </div>\n</div>\n\n<!-- /0 -->\n                    </div>\n\n                </div>\n            </div>\n            <div id=\"cpp-head-second-base\">\n                <div id=\"cpp-head-second\">\n                    <div id=\"cpp-head-tools-left\">\n                        \n<!-- 0 -->\n<div id=\"p-namespaces\" class=\"vectorTabs\">\n\t<h5>Namespaces</h5>\n\t<ul>\n\t\t\t\t\t<li id=\"ca-nstab-main\" class=\"selected\"><span><a href=\"https://en.cppreference.com/w/cpp/container/array.html\" title=\"View the content page [c]\" accesskey=\"c\">Page</a></span></li>\n\t\t\t\t\t<li id=\"ca-talk\"><span><a href=\"https://en.cppreference.com/w/Talk%253Acpp/container/array.html\" title=\"Discussion about the content page [t]\" accesskey=\"t\">Discussion</a></span></li>\n\t\t\t</ul>\n</div>\n\n<!-- /0 -->\n\n<!-- 1 -->\n<div id=\"p-variants\" class=\"vectorMenu emptyPortlet\">\n\t\t<h5><span>Variants</span><a href=\"https://en.cppreference.com/w/cpp/container/array.html#\"></a></h5>\n\t<div class=\"menu\">\n\t\t<ul>\n\t\t\t\t\t</ul>\n\t</div>\n</div>\n\n<!-- /1 -->\n                    </div>\n                    <div id=\"cpp-head-tools-right\">\n                        \n<!-- 0 -->\n<div id=\"p-views\" class=\"vectorTabs\">\n\t<h5>Views</h5>\n\t<ul>\n\t\t\t\t\t<li id=\"ca-view\" class=\"selected\"><span><a href=\"https://en.cppreference.com/w/cpp/container/array.html\">View</a></span></li>\n\t\t\t\t\t<li id=\"ca-edit\"><span><a href=\"https://en.cppreference.com/mwiki/index.php?title=cpp/container/array&amp;action=edit\" title=\"You can edit this page. Please use the preview button before saving [e]\" accesskey=\"e\">Edit</a></span></li>\n\t\t\t\t\t<li id=\"ca-history\" class=\"collapsible\"><span><a href=\"https://en.cppreference.com/mwiki/index.php?title=cpp/container/array&amp;action=history\" title=\"Past revisions of this page [h]\" accesskey=\"h\">History</a></span></li>\n\t\t\t</ul>\n</div>\n\n<!-- /0 -->\n\n<!-- 1 -->\n<div id=\"p-cactions\" class=\"vectorMenu emptyPortlet\">\n\t<h5><span>Actions</span><a href=\"https://en.cppreference.com/w/cpp/container/array.html#\"></a></h5>\n\t<div class=\"menu\">\n\t\t<ul>\n\t\t\t\t\t</ul>\n\t</div>\n</div>\n\n<!-- /1 -->\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- /header -->\n        <!-- content -->\n\n        <div id=\"cpp-content-base\">\n            <div id=\"content\">\n                <a id=\"top\"></a>\n                <div id=\"mw-js-message\" style=\"display:none;\"></div>\n                                <!-- firstHeading -->\n\n\n\n\n                <h1 id=\"firstHeading\" class=\"firstHeading\"><span style=\"font-size:0.7em; line-height:130%\">std::</span>array</h1>\n                <!-- /firstHeading -->\n                <!-- bodyContent -->\n                <div id=\"bodyContent\">\n                                        <!-- tagline -->\n                    <div id=\"siteSub\">From cppreference.com</div>\n                    <!-- /tagline -->\n                                        <!-- subtitle -->\n                    <div id=\"contentSub\"><span class=\"subpages\">&lt; <a href=\"https://en.cppreference.com/w/cpp.html\" title=\"cpp\">cpp</a>\u200e | <a href=\"https://en.cppreference.com/w/cpp/container.html\" title=\"cpp/container\">container</a></span></div>\n                    <!-- /subtitle -->\n                                                            <!-- bodycontent -->\n                    <div id=\"mw-content-text\" lang=\"en\" dir=\"ltr\" class=\"mw-content-ltr\"><div class=\"t-navbar\" style=\"\"><div class=\"t-navbar-sep\">&nbsp;</div><div class=\"t-navbar-head\"><a href=\"https://en.cppreference.com/w/cpp.html\" title=\"cpp\">C++</a><div class=\"t-navbar-menu\"><div><div><table class=\"t-nv-begin\" cellpadding=\"0\" style=\"line-height:1.1em;\">\n<tbody><tr class=\"t-nv\"><td colspan=\"5\"><a href=\"https://en.cppreference.com/w/cpp/compiler_support.html\" title=\"cpp/compiler support\">Compiler support</a></td></tr>\n<tr class=\"t-nv\"><td colspan=\"5\"><a href=\"https://en.cppreference.com/w/cpp/freestanding.html\" title=\"cpp/freestanding\">Freestanding and hosted</a></td></tr>\n<tr class=\"t-nv\"><td colspan=\"5\"><a href=\"https://en.cppreference.com/w/cpp/language.html\" title=\"cpp/language\">Language</a></td></tr>\n<tr class=\"t-nv\"><td colspan=\"5\"><a href=\"https://en.cppreference.com/w/cpp/standard_library.html\" title=\"cpp/standard library\">Standard library</a></td></tr>\n<tr class=\"t-nv\"><td colspan=\"5\"><a href=\