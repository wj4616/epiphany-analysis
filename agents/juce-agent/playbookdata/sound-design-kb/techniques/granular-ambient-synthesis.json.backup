{
  "title": "Granular Synthesis for Ambient Soundscapes",
  "description": "Creating atmospheric drones, pads, textures, and evolving soundscapes using granular synthesis",
  "source": "curated",
  "harvested_at": "2026-03-29T00:00:00.000000",
