      "code": "target_include_directories(MyPlugin\n    PRIVATE\n        ${CMAKE_CURRENT_SOURCE_DIR}/Source\n        ${CMAKE_CURRENT_SOURCE_DIR}/DSP/Modules\n    PUBLIC\n        ${CMAKE_CURRENT_SOURCE_DIR}/PublicHeaders\n)"
