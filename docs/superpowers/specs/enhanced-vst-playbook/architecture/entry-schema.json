{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Enhanced VST Playbook Knowledge Base Entry Schema",
  "description": "Schema for all knowledge base entries in the enhanced VST playbook",
  "version": "1.0.0",
  "type": "object",

  "definitions": {
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "academic_paper",
            "professional_reference",
            "expert_interview",
            "community_best_practice",
            "tutorial_guide",
            "forum_discussion",
            "internal_derivation"
          ],
          "description": "Source quality level"
        },
        "author": {
          "type": "string",
          "description": "Author name(s)"
        },
        "title": {
          "type": "string",
          "description": "Source title"
        },
        "paper": {
          "type": "string",
          "description": "Paper or book title"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Source URL"
        },
        "page_numbers": {
          "type": "string",
          "description": "Page numbers for references"
        },
        "accessed": {
          "type": "string",
          "format": "date",
          "description": "Date accessed"
        },
        "notes": {
          "type": "string",
          "description": "Additional notes about source"
        }
      }
    },

    "parameter_range": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum normalized parameter value (0-1)"
        },
        "max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Maximum normalized parameter value (0-1)"
        },
        "default": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Default parameter value (0-1)"
        },
        "unit": {
          "type": "string",
          "description": "Human-readable unit (Hz, ms, dB, etc.)"
        },
        "skew": {
          "type": "number",
          "description": "Skew factor for non-linear mapping"
        }
      }
    },

    "algorithm": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string",
          "description": "Human-readable algorithm description"
        },
        "math": {
          "type": "string",
          "description": "Mathematical formula (LaTeX or pseudocode)"
        },
        "coefficients": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "description": "Coefficient formula as string"
          }
        },
        "pseudocode": {
          "type": "string",
          "description": "Implementation pseudocode"
        },
        "complexity": {
          "type": "string",
          "enum": ["O(1)", "O(n)", "O(n log n)", "O(n²)"],
          "description": "Computational complexity"
        }
      }
    },

    "implementation": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "default": "C++"
        },
        "standard": {
          "type": "string",
          "default": "C++17"
        },
        "framework": {
          "type": "string",
          "default": "JUCE 8.0.x"
        },
        "juce_class": {
          "type": "string",
          "description": "JUCE class name if applicable"
        },
        "sample_usage": {
          "type": "string",
          "description": "Code example"
        },
        "file_reference": {
          "type": "string",
          "description": "Reference to implementation file"
        }
      }
    },

    "failure_mode": {
      "type": "object",
      "required": ["id", "symptom", "cause", "fix", "prevention"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(FM|EM|CM)-[0-9]+$",
          "description": "Failure mode ID (FM-xx for generic, EM-xx for session-specific, CM-xx for code)"
        },
        "symptom": {
          "type": "string",
          "description": "What goes wrong (user-visible)"
        },
        "cause": {
          "type": "string",
          "description": "Root cause (developer-focused)"
        },
        "fix": {
          "type": "string",
          "description": "How to fix it"
        },
        "prevention": {
          "type": "string",
          "description": "How to prevent it"
        },
        "detection": {
          "type": "string",
          "description": "How to detect it (testing, tools)"
        },
        "phase": {
          "type": "string",
          "description": "Phase where this typically occurs"
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "serious", "moderate"],
          "description": "Severity level"
        }
      }
    },

    "technique": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Technique name"
        },
        "description": {
          "type": "string",
          "description": "What this technique does"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {"$ref": "#/definitions/parameter_range"},
              {"type": "string"}
            ]
          }
        },
        "variations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },

  "required": ["id", "title", "category", "confidence", "source"],

  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique identifier (kebab-case)"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200,
      "description": "Human-readable title"
    },
    "category": {
      "type": "string",
      "description": "KB category (filters, oscillators, ambient-textures, etc.)"
    },
    "subcategory": {
      "type": "string",
      "description": "Optional subcategory"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Searchable tags"
    },
    "created": {
      "type": "string",
      "format": "date",
      "description": "Creation date"
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "Last update date"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score (0-1)"
    },
    "source": {
      "$ref": "#/definitions/source"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/source"
      },
      "description": "Multiple sources"
    },
    "description": {
      "type": "string",
      "description": "Detailed description"
    },
    "summary": {
      "type": "string",
      "maxLength": 500,
      "description": "Brief summary for quick reference"
    },
    "why": {
      "type": "string",
      "description": "Explanation of why this approach works"
    },
    "how_to_apply": {
      "type": "string",
      "description": "Guidance on when and how to apply"
    },

    "algorithm": {
      "$ref": "#/definitions/algorithm"
    },
    "algorithms": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/algorithm"
      }
    },

    "implementation": {
      "$ref": "#/definitions/implementation"
    },
    "implementations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/implementation"
      }
    },

    "failure_mode": {
      "$ref": "#/definitions/failure_mode"
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/failure_mode"
      }
    },
    "related_failure_modes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(FM|EM|CM)-[0-9]+$"
      },
      "description": "IDs of related failure modes"
    },

    "techniques": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/technique"
      }
    },

    "presets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Reference to preset templates"
    },

    "see_also": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related KB entries"
    },

    "phase_usage": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 12
      },
      "description": "Phases where this entry is typically used"
    },

    "notes": {
      "type": "string",
      "description": "Additional implementation notes"
    },

    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Important warnings"
    },

    "deprecated": {
      "type": "boolean",
      "default": false,
      "description": "Whether this entry is deprecated"
    },
    "deprecated_by": {
      "type": "string",
      "description": "ID of replacement entry"
    }
  }
}